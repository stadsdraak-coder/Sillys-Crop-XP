{
	"schemaVersion": 1,
	"id": "sillys-crop-xp",
	"version": "${version}",
	"name": "Silly's Crop XP",
	"description": "This makes it so harvesting crops gives XP, fully configurable!",
	"authors": [
		"Sillyygoober2/sillygoober2"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/sillys-crop-xp/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"github.sillygoober2.cropxp.SillysCropXp"
		],
		"client": [
			"github.sillygoober2.cropxp.SillysCropXpClient"
		]
	},
	"mixins": [
		"sillys-crop-xp.mixins.json",
		{
			"config": "sillys-crop-xp.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.14",
		"minecraft": ">=1.20",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}